#!/bin/sh
# rpcd-бэкенд для luci-app-awgsplit

. /usr/share/libubox/jshn.sh

BIN=/usr/bin/awgsplit

valid_name() {
	case "$1" in ''|[!A-Za-z]*|*[!A-Za-z0-9_]*) return 1 ;; esac
	[ ${#1} -le "$2" ]
}

reply() { # key value
	json_init
	json_add_string "$1" "$2"
	json_dump
}

case "$1" in
	list)
		cat <<EOF
{
  "status": {},
  "update": {},
  "restart": {},
  "dump": { "tunnel": "str" },
  "interfaces": {},
  "set_default": { "mode": "str", "tunnel": "str" },
  "pages": {},
  "set_page": { "file": "str" },
  "upload_page": { "name": "str" },
  "import_conf": { "conf": "str", "name": "str" }
}
EOF
	;;

	call)
		case "$2" in
			status)
				$BIN status 2>/dev/null || echo '{"running":false,"tunnels":[],"errors":["awgsplit status не отработал"]}'
			;;

			update)
				( $BIN update ) >/dev/null 2>&1 </dev/null &
				reply result started
			;;

			restart)
				# в фоне: перезапуск с dnsmasq может занять дольше таймаута LuCI
				( /etc/init.d/awgsplit restart ) >/dev/null 2>&1 </dev/null &
				reply result started
			;;

			# быстрое переключение со страницы «Обзор»: режим и/или туннель «для всего остального»
			set_default)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var mode mode
				json_get_var tunnel tunnel
				case "$mode" in ''|split|full) ;; *) reply error "Неверный режим"; exit 0 ;; esac
				if [ -n "$tunnel" ]; then
					valid_name "$tunnel" 24 && [ "$(uci -q get awgsplit."$tunnel")" = tunnel ] \
						|| { reply error "Туннель '$tunnel' не найден"; exit 0; }
					uci -q set awgsplit.global.full_tunnel="$tunnel"
				fi
				[ -n "$mode" ] && uci -q set awgsplit.global.mode="$mode"
				uci -q commit awgsplit
				# в фоне: применение пересобирает dnsmasq и может занять дольше таймаута LuCI
				( $BIN start ) >/dev/null 2>&1 </dev/null &
				reply result started
			;;

			# страницы «ВПН упал»: встроенная и свои из /www/awgsplit-pages/. Выбранная — это uhttpd.main.error_page
			pages)
				json_init
				json_add_string current "$(uci -q get uhttpd.main.error_page)"
				json_add_array pages
				json_add_object
				json_add_string path /awgsplit-down.html
				json_add_string title "Встроенная (шутки, сама возвращает на прошлую страницу)"
				json_close_object
				for f in /www/awgsplit-pages/*.html; do
					[ -f "$f" ] || continue
					n=${f##*/}
					json_add_object
					json_add_string path "/awgsplit-pages/$n"
					json_add_string title "$n"
					json_close_object
				done
				json_close_array
				json_dump
			;;

			set_page)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var file file
				ok=0
				case "$file" in
					/awgsplit-down.html) ok=1 ;;
					/awgsplit-pages/*.html)
						n=${file#/awgsplit-pages/}
						case "$n" in ''|.*|*/*|*[!A-Za-z0-9._-]*) ;; *) [ -f "/www$file" ] && ok=1 ;; esac ;;
				esac
				[ "$ok" = 1 ] || { reply error "Такой страницы нет"; exit 0; }
				uci -q set uhttpd.main.error_page="$file" && uci -q commit uhttpd
				( sleep 2; /etc/init.d/uhttpd reload ) >/dev/null 2>&1 </dev/null &
				reply result ok
			;;

			# свой HTML-файл: LuCI загружает его в /tmp/awgsplit-page.upload, здесь он переезжает в /www/awgsplit-pages/
			upload_page)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var name name
				src=/tmp/awgsplit-page.upload
				case "$name" in ''|.*|*/*|*[!A-Za-z0-9._-]*) reply error "Имя файла: латиница, цифры, . _ - и расширение .html"; rm -f "$src"; exit 0 ;; esac
				case "$name" in *.html) ;; *) reply error "Нужен файл с расширением .html"; rm -f "$src"; exit 0 ;; esac
				[ -f "$src" ] || { reply error "Файл не загрузился"; exit 0; }
				if [ "$(wc -c < "$src")" -gt 1048576 ]; then rm -f "$src"; reply error "Файл больше 1 МБ"; exit 0; fi
				grep -q '<' "$src" || { rm -f "$src"; reply error "Это не HTML"; exit 0; }
				mkdir -p /www/awgsplit-pages && sed 's/\r$//' "$src" > "/www/awgsplit-pages/$name" && chmod 644 "/www/awgsplit-pages/$name"
				rm -f "$src"
				reply path "/awgsplit-pages/$name"
			;;

			dump)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var tunnel tunnel
				if ! valid_name "$tunnel" 24; then
					reply output "Неверное имя туннеля"
					exit 0
				fi
				# jshn передаёт значения через окружение (предел ~128 КБ на строку) — режем с запасом
				reply output "$($BIN dump "$tunnel" 2>&1 | awk '{ n += length($0) + 1; if (n > 60000) { print "… вывод обрезан"; exit } print }')"
			;;

			# интерфейсы AmneziaWG/WireGuard для выпадающего списка
			interfaces)
				lst=$(mktemp /tmp/awgsplit-ifaces.XXXXXX) || { echo '{"interfaces":[]}'; exit 0; }
				json_init
				json_add_array interfaces
				uci -q show network | awk -v q="'" '
					/^network\.[^.=]+=interface$/ { split($0, a, /[.=]/); ifc[a[2]] = 1; order[++n] = a[2]; next }
					{
						eq = index($0, "="); if (!eq) next
						k = substr($0, 1, eq - 1); v = substr($0, eq + 1); gsub(q, "", v)
						m = split(k, b, ".")
						if (m == 3 && (b[2] in ifc)) {
							if (b[3] == "proto") proto[b[2]] = v
							if (b[3] == "awgsplit_dns") dns[b[2]] = v
						}
					}
					END {
						for (i = 1; i <= n; i++) {
							s = order[i]; p = proto[s]
							if (p == "amneziawg" || p == "amneziawg3" || p == "wireguard") print s "\t" p "\t" dns[s]
						}
					}' > "$lst"
				while IFS="$(printf '\t')" read -r name proto dns; do
					json_add_object
					json_add_string name "$name"
					json_add_string proto "$proto"
					json_add_string dns "$dns"
					json_close_object
				done < "$lst"
				rm -f "$lst"
				json_close_array
				json_dump
			;;

			# разбирает .conf от AmneziaVPN и создаёт интерфейс
			import_conf)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var conf conf
				json_get_var name name
				if ! valid_name "$name" 15; then
					json_init; json_add_int code 4
					json_add_string output "Имя интерфейса: латиница, цифры и _, с буквы, до 15 символов (например awg_main)."
					json_dump; exit 0
				fi
				if [ -z "$conf" ] || [ ${#conf} -gt 65536 ]; then
					json_init; json_add_int code 1
					json_add_string output "Пустой или слишком большой конфиг."
					json_dump; exit 0
				fi
				umask 077
				tmp=$(mktemp /tmp/awgimport-in.XXXXXX)
				printf '%s\n' "$conf" > "$tmp"
				out=$(/usr/share/awgsplit/import-awg.sh "$tmp" "$name" 2>&1)
				rc=$?
				rm -f "$tmp"
				json_init
				json_add_int code "$rc"
				json_add_string output "$out"
				json_dump
			;;

			*)
				echo '{"error":"unknown method"}'
			;;
		esac
	;;
esac
