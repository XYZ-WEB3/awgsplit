#!/bin/sh
# Публичный (без входа) JSON о живости туннелей — для страницы «ВПН упал» (/awgsplit-down.html и своих страниц).
# Отдаёт только имена, статус и возраст рукопожатия; ни ключей, ни адресов здесь нет.
# Элемент массива tunnels — это ГРУППА туннелей: active — какой туннель сейчас работает, route —
# tunnel | fallback:<имя> | direct (ни один туннель группы не работает), state — связь активного туннеля.

D=/var/run/awgsplit

printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'

if [ ! -f "$D/started" ]; then
	printf '{"state":"off","tunnels":[]}\n'
	exit 0
fi

esc() { printf '%s' "$1" | tr -d '\000-\037"\\'; }

overall=up
out=""
for r in "$D"/*.route; do
	[ -f "$r" ] || continue
	g=${r##*/}; g=${g%.route}
	rt=$(cat "$r" 2>/dev/null)
	act=$(cat "$D/$g.active" 2>/dev/null)
	st=down; age=-1
	if [ -n "$act" ]; then
		st=$(cat "$D/tn.$act.health" 2>/dev/null)
		age=$(cat "$D/tn.$act.hsage" 2>/dev/null)
	fi
	case "$age" in -1|[0-9]*) ;; *) age=-1 ;; esac
	label=$(uci -q get awgsplit."$g".label)
	# «упал» = ни один туннель группы не работает, её трафик идёт напрямую или заблокирован
	case "$rt" in direct) overall=down ;; esac
	out="$out${out:+,}{\"name\":\"$(esc "$g")\",\"label\":\"$(esc "${label:-$g}")\",\"active\":\"$(esc "$act")\",\"state\":\"$(esc "$st")\",\"route\":\"$(esc "$rt")\",\"hsage\":${age:--1}}"
done

printf '{"state":"%s","tunnels":[%s]}\n' "$overall" "$out"
